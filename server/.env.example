
APP_MODE="local_dev"
AUTH_SECRET_KEY="my-secret_key"

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=yuno
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/yuno?sslmode=disable

AWS_REGION="ap-northeast-1"

AI_API_URL=http://localhost:8000

# s3, local, minio
STORAGE_TYPE="minio"

# STORAGE_TYPE이 local인 경우 필요
THUMBNAIL_ROOT_DIR=thumbnail
ORIGINAL_ROOT_DIR=original

# STORAGE_TYPE이 s3인 경우 필요
THUMBNAIL_BUCKET=thumbnail
ORIGINAL_BUCKET=original

# STORAGE_TYPE이 s3이고 모드가 local_dev일경우
S3_ENDPOINT=http://minio:9000


ORIGINAL_STORAGE_URL=http://localhost:9000/original
THUMBNAIL_STORAGE_URL=http://localhost:9000/thumbnail
MINIO_ROOT_USER=root
MINIO_ROOT_PASSWORD=password