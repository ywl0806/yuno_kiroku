# --- 스테이지 1: 빌드 (Build Stage) ---
    FROM golang:1.24-alpine AS builder

    # 빌드에 필요한 도구 및 libvips-dev 설치
    RUN apk add --no-cache \
        --repository=http://dl-cdn.alpinelinux.org/alpine/edge/community \
        vips-dev \
        libheif-dev \
        pkgconfig \
        gcc \
        musl-dev \
        g++ \
        glib-dev \
        expat-dev
    
    WORKDIR /app
    
    # 의존성 설치
    COPY go.mod go.sum ./
    RUN go mod download
    
    # 소스 복사 및 빌드
    COPY . .
    RUN go build -tags lambda -o bootstrap cmd/lambda/main.go
    
    # --- 스테이지 2: 실행 (Runtime Stage) ---
    FROM alpine:3.19
    
    # 실행에 필요한 최소한의 런타임 라이브러리만 설치 (dev 제외)
    RUN apk add --no-cache \
        --repository=http://dl-cdn.alpinelinux.org/alpine/edge/community \
        vips \
        libheif \
        glib \
        expat \
        ca-certificates
    
    WORKDIR /var/task
    
    # 빌드 스테이지에서 생성된 바이너리(bootstrap)만 가져옴
    COPY --from=builder /app/bootstrap /var/task/bootstrap
    
    # 람다 실행 파일 지정
    ENTRYPOINT ["/var/task/bootstrap"]