                    "type": "integer"
                },
                "clan_group_name": {
                    "type": "string"
                },
                "group_id": {
                    "type": "integer"
                },
                "group_name": {
                    "type": "string"
                },
                "valid": {
                    "type": "boolean"
                }
            }
        },
        "services.MediaItemRange": {
            "type": "object",
            "properties": {
