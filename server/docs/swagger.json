                "password",
                "username"
            ],
            "properties": {
                "clan_group_id": {
                    "type": "integer"
                },
                "group_id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 6
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "models.IdentityListResponse": {
            "type": "object",
            "properties": {
